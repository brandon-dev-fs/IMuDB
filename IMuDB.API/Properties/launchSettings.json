{
	"$schema": "http://json.schemastore.org/launchsettings.json",
	"profiles": {
		"http": {
			"commandName": "Project",
			"launchBrowser": true,
			"launchUrl": "swagger",
			"dotnetRunMessages": true,
			"applicationUrl": "http://localhost:4002",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"ASPNETCORE_HOSTINGSTARTUPASSEMBLIES": "Microsoft.AspNetCore.SpaProxy"
			}
		},
		"https": {
			"commandName": "Project",
			"launchBrowser": true,
			"dotnetRunMessages": true,
			"applicationUrl": "https://localhost:4000;http://localhost:4002",
			"launchUrl": "swagger",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"ASPNETCORE_HOSTINGSTARTUPASSEMBLIES": "Microsoft.AspNetCore.SpaProxy"
			}
		}
	}
}
